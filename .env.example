# Names the `home` CLI, the live tests and the bench read. Dummy values; copy to .env (gitignored)
# or export them in your shell. The library never reads these: callers pass everything in. Written by `bun run gen`
# from each connector's manifest (src/connectors/*/index.ts); edit those, not this file.
HUE_BRIDGE_HOST=hue-bridge.local      # optional: found by mDNS (dns-sd) when unset
HUE_BRIDGE_ID=0017880000000000        # optional: the certificate's CN must match it; mDNS finds it when unset
HUE_APPLICATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx # from `home pair`
HUE_CA_FILE=/path/to/hue-root-ca.pem  # optional: a root CA to trust instead of Signify's two, which the package carries
DAIKIN_HOST=192.0.2.20                # optional: the unit's address; found by UDP broadcast when unset (1.5 s a run)
IQ_GATEWAY_HOST=envoy.local           # the IQ Gateway on the LAN (a scheme is tolerated)
IQ_GATEWAY_SERIAL_NUMBER=000000000000 # optional: for `home enphase login`; from the Enphase app: System > Devices > Gateway
ENPHASE_USERNAME=you@example.com      # optional: for `home enphase login`, once a year: the Enphase account
ENPHASE_PASSWORD=xxxxxxxx             # optional: for `home enphase login`; never stored, only sent to Enphase's login service
AMBER_KEY=psk_xxxxxxxx                # Amber Electric API key (app.amber.com.au/developers)
AMBER_SITE_ID=                        # optional: the first active site is used when unset
UP_TOKEN=up:yeah:xxxxxxxx             # Up personal access token (api.up.com.au/getting_started)
UP_ACCOUNT=JOINT TRANSACTIONAL        # optional: which accounts count, by ownership and type; every account when unset
UP_HOUSEHOLD=home tag:home            # optional: what counts as the household's: Up category ids and tag:labels; everything when unset
HOME_LATITUDE=-33.8688                # the home's position for weather and the sun (this one is Sydney CBD)
HOME_LONGITUDE=151.2093
HOME_TIMEZONE=Australia/Sydney        # optional: the home's IANA time zone for weather times and day blocks; this machine's when unset
HOME_BOM_FORECAST=Sydney              # optional: BOM précis location by name or aac; unset, the forecast comes from Open-Meteo
GOOGLE_WEATHER_KEY=                   # optional: Maps Platform key with the Weather API enabled
SOLOIST_WS=ws://127.0.0.1:9091        # Soloist's --ws address as a URL; `home status` skips the speaker without it
SOLOIST_MAX_VOLUME=60                 # optional: the loudest `home spotify volume` sets, and where a first play above it is lowered to
HOME_CONFIG=                          # optional: a home config (JSONC), e.g. ~/home/home.jsonc; else the names above
