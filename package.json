{
  "name": "@khalido/home",
  "version": "0.1.0",
  "description": "home.ts: small, typed home automation for TypeScript: Hue, Daikin, Enphase, Google Cast, AirPrint printers and a Spotify Soloist speaker on the local network; Amber prices, Up Bank spending and the weather from the cloud.",
  "license": "MIT",
  "author": "Khalid Omar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khalido/home.ts.git"
  },
  "homepage": "https://github.com/khalido/home.ts#readme",
  "bugs": "https://github.com/khalido/home.ts/issues",
  "keywords": [
    "philips-hue",
    "hue",
    "enphase",
    "envoy",
    "daikin",
    "home-automation",
    "bun",
    "amber-electric",
    "weather",
    "chromecast",
    "google-cast",
    "bom",
    "airprint",
    "ipp",
    "printer",
    "spotify",
    "spotify-connect",
    "up-bank"
  ],
  "engines": {
    "bun": ">=1.4",
    "node": ">=24"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hue": {
      "types": "./dist/connectors/hue/index.d.ts",
      "import": "./dist/connectors/hue/index.js"
    },
    "./daikin": {
      "types": "./dist/connectors/daikin/index.d.ts",
      "import": "./dist/connectors/daikin/index.js"
    },
    "./enphase": {
      "types": "./dist/connectors/enphase/index.d.ts",
      "import": "./dist/connectors/enphase/index.js"
    },
    "./amber": {
      "types": "./dist/connectors/amber/index.d.ts",
      "import": "./dist/connectors/amber/index.js"
    },
    "./up": {
      "types": "./dist/connectors/up/index.d.ts",
      "import": "./dist/connectors/up/index.js"
    },
    "./weather": {
      "types": "./dist/connectors/weather/index.d.ts",
      "import": "./dist/connectors/weather/index.js"
    },
    "./weather/ftp": {
      "types": "./dist/connectors/weather/ftp.d.ts",
      "import": "./dist/connectors/weather/ftp.js"
    },
    "./cast": {
      "types": "./dist/connectors/cast/index.d.ts",
      "import": "./dist/connectors/cast/index.js"
    },
    "./printers": {
      "types": "./dist/connectors/printers/index.d.ts",
      "import": "./dist/connectors/printers/index.js"
    },
    "./spotify": {
      "types": "./dist/connectors/spotify/index.d.ts",
      "import": "./dist/connectors/spotify/index.js"
    },
    "./cast/tls": {
      "types": "./dist/connectors/cast/tls.d.ts",
      "import": "./dist/connectors/cast/tls.js"
    },
    "./cast/serve": {
      "types": "./dist/connectors/cast/serve.d.ts",
      "import": "./dist/connectors/cast/serve.js"
    },
    "./node": {
      "types": "./dist/node-fetch.d.ts",
      "import": "./dist/node-fetch.js"
    },
    "./finders": {
      "types": "./dist/finders-entry.d.ts",
      "import": "./dist/finders-entry.js"
    }
  },
  "bin": {
    "home": "src/cli/main.ts"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "llms.txt",
    ".env.example",
    "dist",
    "docs",
    "!docs/handover.md",
    "!docs/publishing.md",
    "examples",
    "skills",
    "src",
    "home.schema.json"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "check": "bun fmt --check && bun check --no-script && bun check --no-script -p tsconfig.build.json && bun check --no-script -p tsconfig.node.json",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.node.json",
    "bench": "bun bench/bench.ts",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "schema": "bun scripts/schema.ts",
    "gen": "bun scripts/gen.ts"
  },
  "dependencies": {
    "basic-ftp": "^6.2.3",
    "cac": "^7.1.0",
    "fast-xml-parser": "^5.11.2",
    "jsonc-parser": "^3.3.1",
    "suncalc": "^2.1.1",
    "undici": "^8.12.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "mitata": "^1.0.34",
    "typescript": "^7.0.2"
  }
}
